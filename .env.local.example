APP_NAME="Helena Beach Resort"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local SQLite. The file is created automatically by `php artisan migrate --force`.
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

# Local development runs over plain http://localhost.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# `sync` keeps local mail/log output synchronous; no queue worker is required.
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Local mail is written to storage/logs/laravel.log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@localhost
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Allows hitting /cron/reservations locally. Never reuse this value in production.
CRON_SECRET=local-dev-cron-secret

# Payment proof uploads use the `cloudflare` disk in code; set R2 test
# credentials here if you need to exercise that flow locally.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

TRUSTED_PROXIES=

BOOKING_REF_PREFIX=HB-
